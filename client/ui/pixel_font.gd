class_name PixelFont
## Пиксельный шрифт 5×7. Сгенерировано tools/make_font_gd.py — не править руками.
##
## Использование:
##   PixelFont.draw(image, "БОЙ", 4, 3, Color.WHITE)
##   var w := PixelFont.width("ЗОЛОТО")

