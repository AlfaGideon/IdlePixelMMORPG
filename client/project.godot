; Конфигурация проекта Godot. Правится и в редакторе (Project → Project Settings).
; Здесь только то, что важно для мобильного idle-RPG: портрет+ландшафт, пиксель-арт,
; совместимый рендерер (нужен для web-экспорта).

config_version=5

[application]

config/name="IdlePixelMMORPG"
config/description="Idle-RPG: боевые классы, монстры и уровни, общий мир, аукцион."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; 6 = SCREEN_SENSOR: и портрет, и ландшафт, как повернут телефон
window/handheld/orientation=6

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
; без этого экспорт в Android и Web не проходит проверку платформы
textures/vram_compression/import_etc2_astc=true
