; Конфигурация проекта Godot. Правится и в редакторе (Project → Project Settings).
; Здесь только то, что важно для мобильного idle-RPG: портрет+ландшафт, пиксель-арт,
; совместимый рендерер (нужен для web-экспорта).

config_version=5

[game]

selection/required="true"

player/hero_class="warrior"

[application]

config/name="IdlePixelMMORPG"
config/description="Idle-RPG: боевые классы, монстры и уровни, общий мир, аукцион."
run/main_scene="res://boot.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://art/icon.png"

[boot_splash]

show_image=false
bg_color=Color(0.031, 0.043, 0.094, 1)
fullsize=false
minimum_display_time=0
use_filter=false

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; 6 = SCREEN_SENSOR: и портрет, и ландшафт, как повернут телефон
window/handheld/orientation=6

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

environment/defaults/default_clear_color=Color(0.031, 0.043, 0.094, 1)

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
; без этого экспорт в Android и Web не проходит проверку платформы
textures/vram_compression/import_etc2_astc=true
